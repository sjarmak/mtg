{
  "name": "mtg-lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "MTG set-generation and playing lab: rules kernel, mechanics DSL, set generation, playtesting",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "node --max-old-space-size=8192 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "tsx packages/slice/tools/test-load/with-lock.ts -- npx vitest run",
    "test:watch": "vitest",
    "test:balance": "vitest run --project balance",
    "generate:live": "vitest run --config packages/setgen/tools/vitest.live.config.ts",
    "lint": "eslint packages --max-warnings=0",
    "format": "prettier --check \"packages/**/*.{ts,json}\"",
    "format:fix": "prettier --write \"packages/**/*.{ts,json}\"",
    "vocabulary:refresh": "tsx packages/dsl/tools/vocabulary-snapshot.ts",
    "slice": "tsx packages/slice/src/cli.ts",
    "play": "tsx packages/ui/tools/play.ts",
    "backend": "tsx packages/ui/tools/backend.ts",
    "forge:install": "bash tools/forge/install.sh",
    "forge:closure": "tsx packages/data/tools/forge-syntax-closure.ts",
    "verify:legacy-cube-live": "tsx packages/ui/tools/legacy-cube-live-smoke.ts",
    "verify:live": "tsx packages/slice/tools/test-load/with-forge-lock.ts -- tsx packages/ui/tools/live-journey.ts",
    "verify:legacy-cube-attack-live": "tsx packages/ui/tools/installed-forge-attack-live.ts",
    "netplay": "tsx packages/ui/tools/netplay.ts",
    "table": "tsx packages/ui/tools/table.ts",
    "lab": "tsx packages/ui/tools/lab.ts",
    "queue": "tsx packages/slice/tools/lane-queue/cli.ts",
    "stalled-work": "tsx packages/slice/tools/stalled-work/cli.ts",
    "gate": "tsx packages/slice/tools/gate/cli.ts",
    "gate:merge": "tsx packages/slice/tools/gate/merge-entry.ts",
    "design": "tsx packages/setgen/tools/design.ts",
    "deckbench": "tsx packages/decklab/tools/deckbench.ts",
    "analyze": "tsx packages/ui/tools/analyze.ts",
    "review:design": "tsx packages/ui/tools/design-review.ts",
    "ui:probe": "tsx packages/ui/tools/ui-probe.ts",
    "reference:import": "tsx packages/data/tools/import-reference-sets.ts",
    "reference:profiles": "tsx packages/data/tools/build-reference-profiles.ts",
    "reference:diff": "tsx packages/setgen/tools/reference-profile-diff.ts",
    "archetypes:refresh": "tsx packages/data/tools/refresh-printed-archetypes.ts",
    "calibrate:draft": "tsx packages/metrics/tools/draft-calibration.ts",
    "calibrate:draft-campaign": "tsx packages/metrics/tools/draft-campaign.ts",
    "calibrate:sealed": "tsx packages/metrics/tools/sealed-calibration.ts",
    "git-hooks:install": "tsx packages/slice/tools/git-hooks/install.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.39.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "better-sqlite3": "^12.4.1",
    "zod": "^4.1.12"
  },
  "engines": {
    "node": ">=22"
  }
}
